# Dev-only agent file bridge (vite/agent-file-plugin.ts).
#
# Confines the bridge to one or more directory trees: absolute paths outside
# every root are rejected with 403. Separate roots with the platform path
# delimiter (`:` on macOS/Linux, `;` on Windows). Leave it unset to allow any
# path except .git and node_modules. Shell exports take precedence.
#
# EXCALIDRAW_ULTIMATE_ALLOWED_ROOTS=/absolute/path/to/project-a:/absolute/path/to/project-b
