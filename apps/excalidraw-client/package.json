{
  "name": "@apps/excalidraw-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier",
    "check": "pnpm test && pnpm typecheck && prettier --check \"src/**/*.{ts,tsx,css}\" vite.config.ts eslint.config.js prettier.config.js tsconfig.json package.json README.md && eslint"
  },
  "imports": {
    "#global.css": "./src/styles/global.css"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/router-plugin": "^1.168.48",
    "browser-fs-access": "^0.39.0",
    "clsx": "^2.1.1",
    "nitro": "3.0.260903-beta",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "srvx": "^1.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
